[configuration]

entry_symbol = "godot_box3d_main"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/libgodot-box3d.so"
linux.release.x86_64 = "res://bin/libgodot-box3d.so"
windows.debug.x86_64 = "res://bin/godot-box3d.dll"
windows.release.x86_64 = "res://bin/godot-box3d.dll"
macos.debug = "res://bin/libgodot-box3d.dylib"
macos.release = "res://bin/libgodot-box3d.dylib"
android.debug.arm64 = "res://bin/android/libgodot-box3d.android.debug.arm64.so"
android.release.arm64 = "res://bin/android/libgodot-box3d.android.release.arm64.so"
android.debug.x86_64 = "res://bin/android/libgodot-box3d.android.debug.x86_64.so"
android.release.x86_64 = "res://bin/android/libgodot-box3d.android.release.x86_64.so"
