[configuration]

entry_symbol = "godot_box3d_main"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/godot-box3d/bin/libgodot-box3d.so"
linux.release.x86_64 = "res://addons/godot-box3d/bin/libgodot-box3d.so"
windows.debug.x86_64 = "res://addons/godot-box3d/bin/godot-box3d.dll"
windows.release.x86_64 = "res://addons/godot-box3d/bin/godot-box3d.dll"
macos.debug = "res://addons/godot-box3d/bin/libgodot-box3d.dylib"
macos.release = "res://addons/godot-box3d/bin/libgodot-box3d.dylib"
web.wasm32.single.debug = "./bin/web/libgodot-box3d.web.template_debug.wasm32.nothreads.wasm"
web.wasm32.single.release = "./bin/web/libgodot-box3d.web.template_release.wasm32.nothreads.wasm"
